# Port 80: health only. ai-toolbox is NOT public — it has no auth and listens on 127.0.0.1:8080 only.
# n8n is public on its own port 5678 (no proxy needed).
:80 {
	# Caddy's own health check — no forwarding
	handle /health {
		respond "ok" 200
	}

	# Catch-all — anything that doesn't match above
	handle {
		respond "app-server" 200
	}
}
